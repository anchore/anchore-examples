# This file installs anchorectl binary utility onto a base alpine image.

FROM alpine:3.20

ARG ANCHORECTL_VERSION=6.0.0

# Download, extract, and clean up anchorectl in a single layer
RUN apk add --no-cache curl tar && \
    curl -LO "https://anchorectl-releases.anchore.io/anchorectl/v${ANCHORECTL_VERSION}/anchorectl_${ANCHORECTL_VERSION}_linux_amd64.tar.gz" && \
    tar -xzf anchorectl_${ANCHORECTL_VERSION}_linux_amd64.tar.gz && \
    mv anchorectl /usr/local/bin/ && \
    rm -rf anchorectl_${ANCHORECTL_VERSION}_linux_amd64.tar.gz /var/cache/apk/*


CMD ["/usr/local/bin/anchorectl"]
